<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both read a USB iPhone's screen through AVCapture, and this is the
	     documented way to ask for it under the hardened runtime. Measured on
	     macOS 27, an iPhone's screen did not need it (scripts/build-prebuilt.sh
	     says how); it is kept as the declared use. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
