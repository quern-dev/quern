{
  "name": "quern-debug-mcp",
  "version": "0.25.0-beta.2",
  "description": "MCP server for Quern — thin wrapper over HTTP API",
  "type": "module",
  "main": "dist/launcher.cjs",
  "bin": {
    "quern-debug-mcp": "dist/launcher.cjs"
  },
  "scripts": {
    "build": "tsc && cp src/launcher.cjs dist/launcher.cjs && chmod 755 dist/launcher.cjs dist/index.js",
    "dev": "tsc --watch",
    "test": "node --test --test-force-exit test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
