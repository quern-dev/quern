<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/log_heading" android:text="Logs"
        android:textSize="20sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/log_status" android:text="stopped" android:paddingTop="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/log_tick_count" android:text="0" android:textSize="24sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Button android:id="@+id/log_start" android:text="Start emitting"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Button android:id="@+id/log_stop" android:text="Stop emitting"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Button android:id="@+id/log_burst" android:text="Emit burst"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
