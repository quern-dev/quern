<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/location_heading" android:text="Location"
        android:textSize="20sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/location_auth" android:text="authorization: unknown"
        android:paddingTop="16dp" android:fontFamily="monospace"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/location_lat" android:text="latitude: —"
        android:fontFamily="monospace"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/location_lon" android:text="longitude: —"
        android:fontFamily="monospace"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/location_speed" android:text="speed: —"
        android:fontFamily="monospace"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/location_time" android:text="timestamp: —"
        android:fontFamily="monospace"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/location_count" android:text="updates: 0"
        android:fontFamily="monospace"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
