<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/link_heading" android:text="Deep Links"
        android:textSize="20sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="Last URI received:" android:paddingTop="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/link_last_uri" android:text="none"
        android:textIsSelectable="true"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Links received:" android:paddingTop="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/link_count" android:text="0" android:textSize="24sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
